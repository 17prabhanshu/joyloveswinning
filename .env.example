# JOY Agent Environment Configuration

# ---------------------------------------------------------
# GEMINI API KEY (REQUIRED)
# ---------------------------------------------------------
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY="your_api_key_here"

# ---------------------------------------------------------
# DEMO REPLAY MODE (OPTIONAL)
# ---------------------------------------------------------
# Set to 1 to disable live API calls and strictly serve
# cached responses from `.llm_cache/`. Use this as an 
# emergency safety net during hackathon judging.
DEMO_REPLAY_MODE=0
